  portrait: {fileID: 21300000, guid: 998aca56ed2dbf24db1f07148333735c, type: 3}
  customDialogue:
  - isPlayer: 1
    text: tsc... Late Louie?
  - isPlayer: 0
    text: '...ah...wait

      WAIT....'
  - isPlayer: 1
